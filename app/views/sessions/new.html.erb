<section class="mx-auto grid w-full max-w-5xl overflow-hidden rounded-3xl border-4 border-slate-900 bg-amber-50 shadow-xl md:grid-cols-2">
  <aside class="flex flex-col justify-end bg-slate-950 p-6 text-amber-100">
    <%= image_tag "/images/dr-q-welcome.png", alt: "Dr. Q welcomes returning Quantum Adventure explorers", class: "mx-auto max-h-[34rem] w-auto object-contain" %>
    <p class="mt-4 text-center text-sm font-bold uppercase tracking-wide text-amber-300">Dr. Q, your quantum guide</p>
  </aside>

  <div class="p-8">
    <% if alert = flash[:alert] %>
      <p class="mb-5 rounded bg-rose-100 px-3 py-2 font-medium text-rose-800" id="alert"><%= alert %></p>
    <% end %>

    <% if notice = flash[:notice] %>
      <p class="mb-5 rounded bg-emerald-100 px-3 py-2 font-medium text-emerald-800" id="notice"><%= notice %></p>
    <% end %>

    <p class="font-bold uppercase tracking-widest text-indigo-700">Welcome back to the Quantum Lab</p>
    <h1 class="mt-2 text-3xl font-black uppercase">Continue your adventure</h1>
    <p class="mt-3 text-slate-700">Dr. Q saved your XP, badges, and mission progress. Sign in to pick up your next quantum challenge.</p>
    <p class="mt-2 text-sm text-slate-600">New explorer? <%= link_to "Create an explorer profile", new_registration_path, class: "font-bold underline" %></p>

    <%= form_with url: session_path, class: "mt-6 space-y-4" do |form| %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "Enter your email address", value: params[:email_address], class: "w-full rounded border-2 border-slate-700 p-3" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Enter your password", maxlength: 72, class: "w-full rounded border-2 border-slate-700 p-3" %>
      <%= form.submit "Resume adventure", class: "w-full rounded bg-indigo-700 px-4 py-3 font-bold text-white" %>
    <% end %>

    <p class="mt-4 text-sm"><%= link_to "Forgot password?", new_password_path, class: "underline" %></p>
  </div>
</section>
