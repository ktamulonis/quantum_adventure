<section class="w-full space-y-6">
  <p class="font-bold uppercase text-indigo-700">Mission 9 · Learn → Experiment → Quiz → Earn</p>

  <header class="grid items-center gap-5 rounded-2xl border-2 border-slate-900 bg-white p-5 md:grid-cols-[1fr_12rem]">
    <div>
      <h1 class="text-4xl font-black">Error Correction</h1>
      <p class="mt-3 max-w-3xl text-lg">Quantum states are delicate, yet redundancy can protect useful information. This lesson uses the smallest three-qubit repetition code to correct one bit-flip error.</p>
    </div>
    <%= image_tag "/images/mission-error-correction.png", alt: "Illustration of quantum error correction", class: "mx-auto h-48 w-48 object-contain" %>
  </header>

  <%= render "missions/history_story", mission: @mission %>

  <section class="rounded-2xl border-2 border-slate-900 bg-amber-50 p-5">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="font-bold uppercase text-amber-800">Dr. Q’s mission briefing</p>
        <p class="mt-1 max-w-3xl">We cannot make an independent copy of an unknown quantum state. Instead, the encoder distributes one logical state across three physical qubits. Two extra syndrome qubits compare parities so we can locate a bit flip without reading the logical value directly.</p>
      </div>
      <%= image_tag "/images/dr-q-welcome.png", alt: "Dr. Q explains quantum error correction", class: "h-28 w-28 object-contain object-top" %>
    </div>
  </section>

  <%= turbo_frame_tag "error-correction-experiment" do %>
    <section class="rounded-2xl border-2 border-slate-900 bg-white p-5" aria-label="Error correction simulator">
      <h2 class="text-xl font-black">Protect a state, then test one bit flip</h2>
      <div class="mt-4 grid gap-4 lg:grid-cols-2">
        <div>
          <p class="font-bold">1. Choose the logical input</p>
          <div class="mt-2 flex flex-wrap gap-2">
            <% ErrorCorrectionLesson::INPUTS.each do |key, label| %>
              <%= link_to label, mission_path(@mission, input: key, error_qubit: @lesson.error_key),
                          data: { turbo_frame: "error-correction-experiment" },
                          class: "rounded border-2 border-slate-900 px-3 py-2 font-bold #{key == @lesson.input ? 'bg-amber-300' : 'bg-white'}" %>
            <% end %>
          </div>
        </div>
        <div>
          <p class="font-bold">2. Choose one physical bit-flip test</p>
          <div class="mt-2 flex flex-wrap gap-2">
            <% ErrorCorrectionLesson::ERROR_OPTIONS.each do |key, label| %>
              <%= link_to label, mission_path(@mission, input: @lesson.input, error_qubit: key),
                          data: { turbo_frame: "error-correction-experiment" },
                          class: "rounded border-2 border-slate-900 px-3 py-2 font-bold #{key == @lesson.error_key ? 'bg-rose-300' : 'bg-white'}" %>
            <% end %>
          </div>
        </div>
      </div>

      <section class="mt-5 rounded-xl border-2 border-indigo-800 bg-indigo-50 p-4">
        <h3 class="text-xl font-black">A genuine QuantumRB correction trace</h3>
        <p class="mt-2">Logical input: <strong>|<%= @lesson.input %>⟩</strong> · injected error: <strong><%= ErrorCorrectionLesson::ERROR_OPTIONS.fetch(@lesson.error_key) %></strong></p>
        <p class="mt-2"><%= @lesson.correction_message %></p>
      </section>

      <div class="mt-6 space-y-5">
        <% @lesson.protocol.stages.each_with_index do |stage, index| %>
          <article class="rounded-xl border-2 border-slate-900 bg-white p-4" data-stage="<%= stage.key %>">
            <p class="font-bold uppercase text-indigo-700">Stage <%= index + 1 %></p>
            <h3 class="mt-1 text-2xl font-black"><%= stage.title %></h3>
            <p class="mt-2 max-w-4xl"><%= stage.explanation %></p>
            <% if stage.syndrome %>
              <p class="mt-3 rounded bg-amber-100 p-3 font-bold">Measured syndrome: <%= stage.syndrome.join %> · <%= stage.correction_qubit.nil? ? 'no data-qubit correction' : "correct q#{stage.correction_qubit}" %></p>
            <% end %>
            <div class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
              <% stage.data_amplitudes.each do |basis, amplitude| %>
                <% probability = amplitude.abs2 %>
                <section class="rounded border border-slate-300 bg-slate-50 p-2 text-sm <%= probability > 1e-10 ? 'border-indigo-500' : '' %>">
                  <p class="font-black">|<%= basis %>⟩</p>
                  <p>Amplitude: <strong><%= format_complex(amplitude) %></strong></p>
                  <p>Probability: <strong><%= format('%.1f%%', probability * 100) %></strong></p>
                </section>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>

      <section class="mt-6 rounded-xl border-2 border-emerald-800 bg-emerald-100 p-4" aria-label="Error correction result">
        <h3 class="text-xl font-black">Recovered logical state</h3>
        <p class="mt-2">Fidelity with the original logical input: <strong><%= format('%.6f', @lesson.protocol.fidelity) %></strong></p>
        <p class="mt-2">Logical |0⟩ probability: <strong><%= format('%.1f%%', @lesson.protocol.corrected_logical_statevector.probability_of('0') * 100) %></strong> · Logical |1⟩ probability: <strong><%= format('%.1f%%', @lesson.protocol.corrected_logical_statevector.probability_of('1') * 100) %></strong></p>
        <p class="mt-3">This repetition code corrects one X (bit-flip) error only. It does not correct phase flips, two simultaneous errors, or all of the effects of a real device. Larger quantum error-correcting codes are designed for those harder cases.</p>
      </section>
      <%= render "missions/discovery_clues", mission: @mission, unlocked_clues: @unlocked_mission_clues %>
    </section>
  <% end %>

  <%= render "missions/qbit_tutor", mission: @mission %>
  <%= link_to "Take the Error Correction quiz", quiz_mission_path(@mission), class: "inline-block rounded bg-indigo-700 px-5 py-3 font-bold text-white" %>
</section>
