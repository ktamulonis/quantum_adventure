<section class="w-full space-y-6">
  <p class="font-bold uppercase text-indigo-700">Mission 2 · Learn → Experiment → Quiz → Earn</p>
  <header class="grid items-center gap-5 rounded-2xl border-2 border-slate-900 bg-white p-5 md:grid-cols-[1fr_12rem]">
    <div>
      <h1 class="text-4xl font-black">Superposition</h1>
      <p class="mt-3 max-w-3xl text-lg">Create and inspect states such as |+⟩. Hadamard prepares a state aligned to X that can look random in Z while remaining perfectly predictable in X.</p>
    </div>
    <%= image_tag "/images/mission-superposition.png", alt: "Illustration of a Bloch sphere showing the plus superposition state", class: "mx-auto h-48 w-48 object-contain" %>
  </header>
  <div class="flex flex-wrap gap-2"><% SuperpositionLesson::PRESETS.each do |preset, (name, _)| %><%= link_to name, mission_path(@mission, preset: preset), class: "rounded border-2 border-slate-900 px-3 py-2 #{preset == @lesson.preset ? 'bg-amber-300' : 'bg-white'}" %><% end %></div>
  <section class="rounded-xl border-2 border-slate-900 bg-white p-5"><h2 class="text-2xl font-black"><%= @lesson.state_name %></h2><pre class="mt-3 rounded bg-slate-100 p-3"><%= @lesson.circuit.draw %></pre><p class="mt-3">Amplitudes: |0⟩ = <%= state_amplitude(@lesson.statevector, 0) %>; |1⟩ = <%= state_amplitude(@lesson.statevector, 1) %></p><div class="mt-4 grid gap-4 md:grid-cols-3"><% { "Z" => :z, "X" => :x, "Y" => :y }.each do |basis, key| %><div class="rounded border p-3"><h3 class="font-bold">Measure in <%= basis %></h3><% @lesson.statevector.measurement_probabilities(basis: key).each do |outcome, probability| %><p class="mt-2"><%= outcome %>: <%= format('%.1f%%', probability * 100) %></p><div class="h-2 bg-slate-200"><div class="h-2 bg-indigo-600" style="<%= probability_bar(probability) %>"></div></div><% end %></div><% end %></div></section>
  <%= render "missions/qbit_tutor", mission: @mission %>
  <%= link_to "Take the Superposition quiz", quiz_mission_path(@mission), class: "inline-block rounded bg-indigo-700 px-5 py-3 font-bold text-white" %>
</section>
