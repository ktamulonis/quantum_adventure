<section class="w-full space-y-6">
  <p class="font-bold uppercase text-indigo-700">Mission 4 · Learn → Experiment → Quiz → Earn</p>
  <header class="grid items-center gap-5 rounded-2xl border-2 border-slate-900 bg-white p-5 md:grid-cols-[1fr_12rem]">
    <div>
      <h1 class="text-4xl font-black">Bell Test</h1>
      <p class="mt-3 max-w-3xl text-lg">CHSH compares four measurement settings. Local hidden-variable theories are bounded by 2; ideal quantum mechanics can approach 2√2.</p>
    </div>
    <%= image_tag "/images/mission-bell-test.png", alt: "Illustration of a Bell test between two measurement stations", class: "mx-auto h-48 w-48 object-contain" %>
  </header>
  <%= render "missions/history_story", mission: @mission %>
  <%= turbo_frame_tag "bell-test-experiment" do %>
    <%= form_with url: mission_path(@mission), method: :get, data: { turbo_frame: "bell-test-experiment" }, class: "flex flex-wrap gap-3" do |form| %>
      <%= form.number_field :shots, value: params.fetch(:shots, 2_000), min: 100, max: 10_000, class: "rounded border-2 border-slate-900 p-2" %>
      <%= form.submit "Run CHSH test", class: "rounded bg-indigo-700 px-4 py-2 font-bold text-white" %>
    <% end %>
    <section class="mt-6 rounded-xl border-2 border-slate-900 bg-white p-5"><p class="text-3xl font-black">S = <%= format('%.3f', @lesson.s_value) %></p><p class="mt-2">|S| = <strong><%= format('%.3f', @lesson.s_value.abs) %></strong> · Classical limit: 2 · Quantum maximum: <%= format('%.3f', @lesson.quantum_maximum) %></p><p class="mt-3 font-bold"><%= @lesson.violates_classical_limit? ? 'Bell violation observed' : 'No violation observed in this sample' %></p><ul class="mt-4 list-disc pl-5"><% @lesson.correlations.each_with_index do |correlation, index| %><li>Correlation <%= index + 1 %>: <%= format('%.3f', correlation) %></li><% end %></ul></section>
    <p class="mt-6 rounded-xl border-2 border-slate-900 bg-amber-100 p-5">Bell correlations rule out local hidden-variable explanations; they do not enable faster-than-light messaging.</p>
    <section class="mt-6 rounded-xl border-2 border-slate-900 bg-indigo-50 p-4">
      <p class="font-bold">Choose an observation lens</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <% { "classical_limit" => "Inspect the classical limit", "four_settings" => "Inspect four settings", "meaning" => "What does a violation mean?" }.each do |focus, label| %>
          <%= link_to label, mission_path(@mission, shots: params.fetch(:shots, 2_000), seed: params.fetch(:seed, 42), focus: focus), data: { turbo_frame: "bell-test-experiment" }, class: "rounded border-2 border-slate-900 bg-white px-3 py-2 font-bold" %>
        <% end %>
      </div>
    </section>
    <%= render "missions/discovery_clues", mission: @mission, unlocked_clues: @unlocked_mission_clues %>
  <% end %>
  <%= render "missions/qbit_tutor", mission: @mission %>
  <%= link_to "Take the Bell Test quiz", quiz_mission_path(@mission), class: "inline-block rounded bg-indigo-700 px-5 py-3 font-bold text-white" %>
</section>
