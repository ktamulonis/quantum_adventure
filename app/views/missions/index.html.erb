<section class="w-full">
  <h1 class="text-4xl font-black uppercase">Mission tickets</h1>
  <div class="mt-6 grid gap-4 md:grid-cols-2">
    <% @missions.each do |mission| %>
      <% unlocked = mission.status == "playable" && mission.unlocked_for?(Current.user) %>
      <article class="rounded-xl border-2 border-slate-900 p-5 <%= unlocked ? 'bg-amber-100' : 'bg-slate-200' %>">
        <% if mission.slug == "qubit-basics" %>
          <%= image_tag "/images/mission-qubit-basics.png", alt: "Qubit Basics Bloch sphere", class: "mb-3 h-36 w-full rounded-lg border-2 border-slate-900 object-cover object-center" %>
        <% end %>
        <p class="font-bold">Mission <%= mission.number %></p><h2 class="text-2xl font-black"><%= mission.title %></h2><p class="mt-2"><%= mission.summary %></p>
        <% if unlocked %><%= link_to "Open mission", mission_path(mission.slug), class: "mt-4 inline-block rounded bg-indigo-700 px-4 py-2 font-bold text-white" %><% else %><p class="mt-4 font-bold">Locked / coming soon</p><% end %>
      </article>
    <% end %>
  </div>
</section>
