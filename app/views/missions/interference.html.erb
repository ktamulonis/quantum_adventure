<section class="w-full space-y-6">
  <p class="font-bold uppercase text-indigo-700">Mission 6 · Learn → Experiment → Quiz → Earn</p>

  <header class="grid items-center gap-5 rounded-2xl border-2 border-slate-900 bg-white p-5 md:grid-cols-[1fr_12rem]">
    <div>
      <h1 class="text-4xl font-black">Interference</h1>
      <p class="mt-3 max-w-3xl text-lg">Quantum algorithms do not get useful answers by merely making random superpositions. They arrange amplitudes so some paths reinforce while others cancel.</p>
    </div>
    <%= image_tag "/images/mission-interference.png", alt: "Illustration of interfering quantum wave paths", class: "mx-auto h-48 w-48 object-contain" %>
  </header>

  <section class="rounded-2xl border-2 border-slate-900 bg-amber-50 p-5">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="font-bold uppercase text-amber-800">Dr. Q’s mission briefing</p>
        <p class="mt-1 max-w-3xl">Think of amplitudes like directed waves. Probabilities do not add until after the waves have combined. That lets a later gate make one answer more likely and another less likely.</p>
      </div>
      <%= image_tag "/images/dr-q-welcome.png", alt: "Dr. Q explains quantum interference", class: "h-28 w-28 object-contain object-top" %>
    </div>
  </section>

  <%= turbo_frame_tag "interference-experiment" do %>
    <section class="rounded-2xl border-2 border-slate-900 bg-white p-5" aria-label="Interference simulator">
      <h2 class="text-xl font-black">Choose a wave-path demonstration</h2>
      <p class="mt-1 text-slate-700">Each choice runs an actual QuantumRB circuit and shows its state after every gate.</p>
      <div class="mt-4 flex flex-wrap gap-2">
        <% InterferenceLesson::PRESETS.each do |key, configuration| %>
          <%= link_to configuration.fetch(:title), mission_path(@mission, preset: key),
                      data: { turbo_frame: "interference-experiment" },
                      class: "rounded border-2 border-slate-900 px-3 py-2 font-bold #{key == @lesson.preset ? 'bg-amber-300' : 'bg-white'}" %>
        <% end %>
      </div>

      <div class="mt-5 rounded-xl border-2 border-indigo-800 bg-indigo-50 p-4">
        <h3 class="text-2xl font-black"><%= @lesson.title %></h3>
        <p class="mt-2 max-w-4xl"><%= @lesson.briefing %></p>
        <pre class="mt-4 overflow-x-auto rounded bg-white p-3"><%= @lesson.circuit.draw %></pre>
      </div>

      <div class="mt-6 grid gap-4 <%= @lesson.steps.length == 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-4' %>">
        <% @lesson.steps.each do |step| %>
          <article class="rounded-xl border-2 border-slate-900 bg-white p-4">
            <p class="font-bold uppercase text-indigo-700">Step <%= step.number %></p>
            <h3 class="mt-1 text-lg font-black"><%= step.label %></h3>
            <p class="mt-2 text-sm"><%= step.explanation %></p>
            <div class="mt-4 rounded bg-slate-100 p-3 text-sm">
              <p>|0⟩ amplitude: <strong><%= state_amplitude(step.statevector, 0) %></strong></p>
              <p>|1⟩ amplitude: <strong><%= state_amplitude(step.statevector, 1) %></strong></p>
            </div>
            <% step.probabilities.each do |basis, probability| %>
              <div class="mt-3">
                <div class="flex justify-between text-sm"><span>|<%= basis %>⟩</span><strong><%= format('%.1f%%', probability * 100) %></strong></div>
                <div class="mt-1 h-3 rounded bg-slate-200"><div class="h-3 rounded bg-indigo-600" style="<%= probability_bar(probability) %>"></div></div>
              </div>
            <% end %>
            <p class="mt-3 text-sm">Bloch vector: x <%= format('%.2f', step.bloch_vector.fetch(:x)) %>, y <%= format('%.2f', step.bloch_vector.fetch(:y)) %>, z <%= format('%.2f', step.bloch_vector.fetch(:z)) %></p>
          </article>
        <% end %>
      </div>

      <section class="mt-6 rounded-xl border-2 border-emerald-800 bg-emerald-100 p-4">
        <h3 class="text-xl font-black">What this reveals</h3>
        <p class="mt-2"><%= @lesson.conclusion %></p>
        <p class="mt-3">Useful quantum algorithms carefully steer this same reinforce-or-cancel effect toward useful answers. Measurement is still probabilistic; interference changes the probabilities before the measurement happens.</p>
      </section>
    </section>
  <% end %>

  <%= render "missions/qbit_tutor", mission: @mission %>
  <%= link_to "Take the Interference quiz", quiz_mission_path(@mission), class: "inline-block rounded bg-indigo-700 px-5 py-3 font-bold text-white" %>
</section>
