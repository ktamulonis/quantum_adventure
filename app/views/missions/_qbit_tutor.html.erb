<section class="rounded-2xl border-2 border-slate-900 bg-cyan-50 p-5" data-controller="qbit-chat" data-qbit-chat-url-value="<%= qbit_chat_mission_path(mission) %>">
  <div class="flex items-center gap-4">
    <%= image_tag "/images/qbit.png", alt: "Q-Bit, the Quantum Adventure learning robot", class: "h-24 w-24 rounded-full border-2 border-slate-900 bg-slate-950 object-cover object-top" %>
    <div>
      <p class="font-bold uppercase tracking-widest text-cyan-800">Ask Q-Bit</p>
      <h2 class="text-xl font-black">Your lesson robot guide</h2>
      <p class="text-sm text-slate-700">Ask about this mission’s simulator, gates, measurements, or challenge. Q-Bit answers using a local Ollama model.</p>
    </div>
  </div>

  <div class="mt-4 max-h-72 space-y-3 overflow-y-auto" data-qbit-chat-target="messages" aria-live="polite">
    <article class="rounded-lg bg-white p-3 text-sm"><strong>Q-Bit:</strong> Hi! Ask me what the controls in this lesson are doing, and we’ll investigate together.</article>
  </div>

  <form class="mt-4 flex flex-col gap-2 sm:flex-row" data-action="submit->qbit-chat#ask">
    <label class="sr-only" for="qbit-question">Ask Q-Bit a question</label>
    <input id="qbit-question" type="text" maxlength="1000" placeholder="What happens when I prepare |+⟩?" class="min-w-0 flex-1 rounded border-2 border-slate-700 p-3" data-qbit-chat-target="question">
    <button type="submit" class="rounded bg-cyan-700 px-4 py-3 font-bold text-white disabled:opacity-50" data-qbit-chat-target="submit">Ask Q-Bit</button>
  </form>
  <p class="mt-2 text-sm text-rose-800" data-qbit-chat-target="status" aria-live="polite"></p>
</section>
