<section class="w-full space-y-6">
  <p class="font-bold uppercase text-indigo-700">Mission 1 · Learn → Experiment → Quiz → Earn</p>
  <h1 class="text-4xl font-black">Qubit Basics</h1>
  <p class="max-w-3xl text-lg">A qubit has amplitudes and probabilities. Change the prepared state, then inspect its exact statevector and three measurement bases.</p>
  <div class="flex flex-wrap gap-2"><% QubitBasicsLesson::PRESETS.each do |preset, (name, _)| %><%= link_to name, mission_path(@mission, preset: preset), class: "rounded border-2 border-slate-900 px-3 py-2 #{preset == @lesson.preset ? 'bg-amber-300' : 'bg-white'}" %><% end %></div>
  <section class="rounded-xl border-2 border-slate-900 bg-white p-5"><h2 class="text-2xl font-black">Prepared <%= @lesson.state_name %></h2><pre class="mt-3 rounded bg-slate-100 p-3"><%= @lesson.circuit.draw %></pre><p class="mt-3">Bloch vector: <%= @lesson.statevector.bloch_vector %></p><div class="mt-4 grid gap-4 md:grid-cols-3"><% { "Z" => :z, "X" => :x, "Y" => :y }.each do |basis, key| %><div class="rounded border p-3"><h3 class="font-bold">Measure in <%= basis %></h3><% @lesson.statevector.measurement_probabilities(basis: key).each do |outcome, probability| %><p class="mt-2"><%= outcome %>: <%= format('%.1f%%', probability * 100) %></p><div class="h-2 bg-slate-200"><div class="h-2 bg-indigo-600" style="<%= probability_bar(probability) %>"></div></div><% end %></div><% end %></div></section>
  <%= link_to "Take the Qubit Basics quiz", quiz_mission_path(@mission), class: "inline-block rounded bg-indigo-700 px-5 py-3 font-bold text-white" %>
</section>
