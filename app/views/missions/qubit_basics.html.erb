<section class="w-full space-y-6">
  <p class="font-bold uppercase text-indigo-700">Mission 1 · Learn → Experiment → Quiz → Earn</p>
  <header class="grid items-center gap-5 rounded-2xl border-2 border-slate-900 bg-white p-5 md:grid-cols-[1fr_12rem]">
    <div>
      <h1 class="text-4xl font-black">Qubit Basics</h1>
      <p class="mt-3 max-w-3xl text-lg">Explore one-qubit states and measurement bases. Run each prepared state, inspect the exact results, and unlock a clue that explains what the simulator is showing.</p>
    </div>
    <%= image_tag "/images/mission-qubit-basics.png", alt: "Illustration of a Bloch sphere and one-qubit measurement probabilities", class: "mx-auto h-44 w-44 rounded-xl object-cover" %>
  </header>

  <section class="rounded-xl border-2 border-slate-900 bg-indigo-50 p-5">
    <h2 class="text-xl font-black">Experiment station</h2>
    <p class="mt-1 text-slate-700">Select a preparation to run it. Each selection unlocks a lesson clue for your quiz.</p>
    <div class="mt-4 flex flex-wrap gap-2">
      <% QubitBasicsLesson::PRESETS.each do |preset, (name, _)| %>
        <%= link_to "Prepare #{name}", mission_path(@mission, preset: preset), class: "rounded border-2 border-slate-900 px-3 py-2 font-bold #{preset == @lesson.preset ? 'bg-amber-300' : 'bg-white'}" %>
      <% end %>
    </div>
  </section>

  <section class="rounded-xl border-2 border-slate-900 bg-white p-5">
    <h2 class="text-2xl font-black">Prepared <%= @lesson.state_name %></h2>
    <pre class="mt-3 rounded bg-slate-100 p-3"><%= @lesson.circuit.draw %></pre>
    <div class="mt-3 grid gap-2 text-sm md:grid-cols-2">
      <p>Amplitude of |0⟩: <strong><%= state_amplitude(@lesson.statevector, 0) %></strong></p>
      <p>Amplitude of |1⟩: <strong><%= state_amplitude(@lesson.statevector, 1) %></strong></p>
      <p>Bloch vector: <strong><%= @lesson.statevector.bloch_vector %></strong></p>
    </div>
    <div class="mt-4 grid gap-4 md:grid-cols-3">
      <% { "Z" => :z, "X" => :x, "Y" => :y }.each do |basis, key| %>
        <div class="rounded border p-3">
          <h3 class="font-bold">Measure in <%= basis %></h3>
          <% @lesson.statevector.measurement_probabilities(basis: key).each do |outcome, probability| %>
            <p class="mt-2"><%= outcome %>: <%= format('%.1f%%', probability * 100) %></p>
            <div class="h-2 bg-slate-200"><div class="h-2 bg-indigo-600" style="<%= probability_bar(probability) %>"></div></div>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="rounded-xl border-2 border-slate-900 bg-amber-50 p-5">
    <h2 class="text-xl font-black">Discovery clues</h2>
    <p class="mt-1 text-slate-700">The clues explain the ideas you need for this mission’s quiz.</p>
    <div class="mt-4 grid gap-3 md:grid-cols-3">
      <% QubitBasicsLesson::CLUES.each do |preset, clue| %>
        <% unlocked = @unlocked_qubit_clues&.include?(preset) %>
        <article class="rounded border-2 border-slate-900 p-4 <%= unlocked ? 'bg-white' : 'bg-slate-200 text-slate-600' %>">
          <% if unlocked %>
            <p class="text-sm font-bold uppercase text-emerald-700">Clue unlocked</p>
            <h3 class="mt-1 font-black"><%= clue[:title] %></h3>
            <p class="mt-2 text-sm"><%= clue[:body] %></p>
          <% else %>
            <p class="font-bold">Locked clue</p>
            <p class="mt-2 text-sm">Prepare <%= QubitBasicsLesson::PRESETS.fetch(preset).first %> to reveal this explanation.</p>
          <% end %>
        </article>
      <% end %>
    </div>
  </section>
  <%= render "missions/qbit_tutor", mission: @mission %>
  <%= link_to "Take the Qubit Basics quiz", quiz_mission_path(@mission), class: "inline-block rounded bg-indigo-700 px-5 py-3 font-bold text-white" %>
</section>
