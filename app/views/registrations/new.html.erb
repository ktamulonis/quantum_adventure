<section class="mx-auto grid w-full max-w-5xl overflow-hidden rounded-3xl border-4 border-slate-900 bg-amber-50 shadow-xl md:grid-cols-2">
  <aside class="flex flex-col justify-end bg-slate-950 p-6 text-amber-100">
    <%= image_tag "/images/dr-q-welcome.png", alt: "Dr. Q welcomes new Quantum Adventure explorers", class: "mx-auto max-h-[34rem] w-auto object-contain" %>
    <p class="mt-4 text-center text-sm font-bold uppercase tracking-wide text-amber-300">Dr. Q, your quantum guide</p>
  </aside>

  <div class="p-8">
    <p class="font-bold uppercase tracking-widest text-indigo-700">Welcome to the Quantum Lab</p>
    <h1 class="mt-2 text-3xl font-black uppercase">Join Quantum Adventure</h1>
    <p class="mt-3 text-slate-700">Welcome, explorer! Create your profile to earn XP, collect badges, and unlock the mysteries of quantum mechanics one mission at a time.</p>
    <%= form_with model: @user, url: registration_path, class: "mt-6 space-y-4" do |form| %>
      <% if @user.errors.any? %><div class="rounded bg-rose-100 p-3 text-rose-800"><%= @user.errors.full_messages.to_sentence %></div><% end %>
      <%= form.text_field :display_name, required: true, placeholder: "Explorer name", class: "w-full rounded border-2 border-slate-700 p-3" %>
      <%= form.email_field :email_address, required: true, placeholder: "Email", class: "w-full rounded border-2 border-slate-700 p-3" %>
      <%= form.password_field :password, required: true, placeholder: "Password", class: "w-full rounded border-2 border-slate-700 p-3" %>
      <%= form.password_field :password_confirmation, required: true, placeholder: "Confirm password", class: "w-full rounded border-2 border-slate-700 p-3" %>
      <%= form.submit "Begin adventure", class: "w-full rounded bg-indigo-700 px-4 py-3 font-bold text-white" %>
    <% end %>
    <p class="mt-4 text-sm">Already enrolled? <%= link_to "Sign in", new_session_path, class: "underline" %></p>
  </div>
</section>
