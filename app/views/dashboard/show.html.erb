<section class="w-full space-y-8">
  <header class="rounded-3xl border-4 border-slate-900 bg-indigo-950 p-8 text-amber-100 shadow-xl">
    <p class="font-bold uppercase tracking-widest text-amber-300">Quantum Lab briefing</p>
    <h1 class="mt-2 text-5xl font-black uppercase">Quantum Adventure</h1>
    <p class="mt-3 max-w-2xl text-lg">Welcome, <%= Current.user.display_name %>. Dr. Q and Q-Bot are ready to guide you through the quantum world.</p>
  </header>

  <section class="grid gap-4 md:grid-cols-4">
    <div class="rounded-xl border-2 border-slate-900 bg-amber-100 p-4"><p class="text-sm font-bold uppercase">Level</p><p class="text-3xl font-black"><%= Current.user.level %> Explorer</p></div>
    <div class="rounded-xl border-2 border-slate-900 bg-sky-100 p-4"><p class="text-sm font-bold uppercase">XP points</p><p class="text-3xl font-black"><%= @xp %></p><p><%= @next_threshold ? "Next level at #{@next_threshold}" : "Quantum Master" %></p></div>
    <div class="rounded-xl border-2 border-slate-900 bg-violet-100 p-4"><p class="text-sm font-bold uppercase">Badges</p><p class="text-3xl font-black"><%= Current.user.user_badges.count %> / 10</p></div>
    <div class="rounded-xl border-2 border-slate-900 bg-emerald-100 p-4"><p class="text-sm font-bold uppercase">Missions complete</p><p class="text-3xl font-black"><%= Current.user.mission_completions.count %> / 10</p></div>
  </section>

  <section>
    <h2 class="text-2xl font-black uppercase">Mission roadmap</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-5">
      <% @missions.each do |mission| %>
        <% completed = Current.user.completed?(mission); unlocked = mission.unlocked_for?(Current.user) %>
        <article class="rounded-xl border-2 border-slate-900 p-4 <%= completed ? 'bg-emerald-100' : unlocked && mission.status == 'playable' ? 'bg-amber-100' : 'bg-slate-200 opacity-70' %>">
          <% if mission.slug == "qubit-basics" %>
            <div class="mb-3 flex h-40 w-full items-center justify-center overflow-hidden">
              <%= image_tag "/images/mission-qubit-basics.png", alt: "Qubit Basics Bloch sphere", class: "h-full w-full scale-150 object-contain object-center" %>
            </div>
          <% elsif mission.slug == "superposition" %>
            <div class="mb-3 flex h-40 w-full items-center justify-center overflow-hidden">
              <%= image_tag "/images/mission-superposition.png", alt: "Superposition Bloch sphere", class: "h-full w-full scale-150 object-contain object-center" %>
            </div>
          <% elsif mission.slug == "entanglement" %>
            <div class="mb-3 flex h-40 w-full items-center justify-center overflow-hidden">
              <%= image_tag "/images/mission-entanglement.png", alt: "Entangled qubits", class: "h-full w-full scale-150 object-contain object-center" %>
            </div>
          <% elsif mission.slug == "bell-test" %>
            <div class="mb-3 flex h-40 w-full items-center justify-center overflow-hidden">
              <%= image_tag "/images/mission-bell-test.png", alt: "Bell test measurement stations", class: "h-full w-full scale-150 object-contain object-center" %>
            </div>
          <% elsif mission.slug == "teleportation" %>
            <div class="mb-3 flex h-40 w-full items-center justify-center overflow-hidden">
              <%= image_tag "/images/mission-teleportation.png", alt: "Quantum teleportation between two learning robots", class: "h-full w-full scale-150 object-contain object-center" %>
            </div>
          <% elsif mission.slug == "interference" %>
            <div class="mb-3 flex h-40 w-full items-center justify-center overflow-hidden">
              <%= image_tag "/images/mission-interference.png", alt: "Interference between two quantum wave paths", class: "h-full w-full scale-150 object-contain object-center" %>
            </div>
          <% elsif mission.slug == "grovers-search" %>
            <div class="mb-3 flex h-40 w-full items-center justify-center overflow-hidden">
              <%= image_tag "/images/mission-grovers-search.png", alt: "Grover's search marked state", class: "h-full w-full scale-150 object-contain object-center" %>
            </div>
          <% end %>
          <p class="font-bold">Mission <%= mission.number %></p><h3 class="text-lg font-black"><%= mission.title %></h3><p class="mt-2 text-sm"><%= mission.summary %></p>
          <p class="mt-3 text-sm font-bold"><%= completed ? 'Completed' : unlocked && mission.status == 'playable' ? 'Ready' : 'Locked / coming soon' %></p><% if unlocked && !completed %><%= link_to "Start", mission_path(mission.slug), class: "mt-3 inline-block underline" %><% end %>
        </article>
      <% end %>
    </div>
  </section>
  <%= link_to "View all mission tickets", missions_path, class: "inline-block rounded bg-indigo-700 px-5 py-3 font-bold text-white" %>
</section>
